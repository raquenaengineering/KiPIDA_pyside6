{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.raquenaengineering.kipida-pyside6",
    "name": "Ki-PIDA (PySide6)",
    "description": "Power Integrity & Delivery Analyzer for KiCad",
    "version": "0.5.1",
    "kicad_version": "10.0",
    "status": "stable",
    "runtime": {
        "type": "python",
        "min_version": "3.11"
    },
    "actions": [
        {
            "identifier": "kipida_sim",
            "name": "Ki-PIDA Simulation (PySide6)",
            "description": "Run Power Integrity Analysis",
            "show-button": true,
            "scopes": ["pcb"],
            "entrypoint": "ipc_entry.py",
            "icons-light": ["resources/kipida.png"],
            "icons-dark": ["resources/kipida.png"]
        }
    ]
}
